  "lessons": [
    {
      "id": "u0-l1", "position": 1, "title": "Hiragana: vowels and the か row",
      "summary": "Meet the five Japanese vowels and the k-sounds, the building blocks of every word.",
      "objectives": ["Recognise あ い う え お and か き く け こ", "Hear the difference between short Japanese vowels", "Read and type simple words like あおい and いえ"],
      "prerequisites": [], "difficulty": 1, "estimated_minutes": 10,
      "vocabulary_ids": ["kana-a", "kana-i", "kana-u", "kana-e", "kana-o", "kana-ka", "kana-ki", "kana-ku", "kana-ke", "kana-ko", "v-aoi", "v-ie"],
      "grammar_ids": [],
      "exercises": [
        {"type": "presentation", "skill": "reading", "instructions": "Listen and read the five vowels.",
          "prompt_ja": "あ い う え お", "prompt_reading": "あ い う え お", "prompt_romaji": "a i u e o", "prompt_en": "The five Japanese vowels",
          "audio_text": "あ、い、う、え、お", "concept_ids": ["kana-a", "kana-i", "kana-u", "kana-e", "kana-o"],
          "explanation": "Japanese vowels are short and crisp. Each kana is one beat (mora), so あおい has three equal beats: a-o-i."},
        {"type": "presentation", "skill": "reading", "instructions": "Now the k-row: k + each vowel.",
          "prompt_ja": "か き く け こ", "prompt_reading": "か き く け こ", "prompt_romaji": "ka ki ku ke ko", "prompt_en": "The か (k) row",
          "audio_text": "か、き、く、け、こ", "concept_ids": ["kana-ka", "kana-ki", "kana-ku", "kana-ke", "kana-ko"],
          "explanation": "Most hiragana are a consonant plus one of the five vowels."},
        {"type": "multiple_choice", "skill": "reading", "instructions": "Which hiragana is 'ka'?",
          "choices": ["か", "き", "く", "こ"], "answer": "か", "hints": ["It looks a bit like a 'k' with an extra stroke."],
          "concept_ids": ["kana-ka"], "explanation": "か = ka. き = ki, く = ku, こ = ko."},
        {"type": "listening_choice", "skill": "listening", "instructions": "Listen and choose the kana you hear.",
          "audio_text": "き", "choices": ["か", "き", "く", "け"], "answer": "き",
          "concept_ids": ["kana-ki"], "explanation": "You heard き (ki)."},
        {"type": "multiple_choice", "skill": "reading", "instructions": "How do you read this kana?",
          "prompt_ja": "こ", "choices": ["ko", "ku", "ke", "ka"], "answer": "ko",
          "concept_ids": ["kana-ko"], "explanation": "こ is read 'ko'."},
        {"type": "listening_choice", "skill": "listening", "instructions": "Listen: which word did you hear?",
          "audio_text": "いえ", "choices": ["いえ", "うえ", "あお", "いけ"], "answer": "いえ",
          "concept_ids": ["v-ie", "kana-i", "kana-e"], "explanation": "いえ (家) means 'house'."},
        {"type": "typed_japanese", "skill": "writing", "instructions": "Type 'aoi' (blue) in hiragana.",
          "prompt_en": "blue (aoi)", "answer": "あおい", "accepted_answers": ["青い"],
          "hints": ["Three vowels: a + o + i.", "With a Japanese keyboard, typing a-o-i produces あおい."],
          "concept_ids": ["v-aoi", "kana-a", "kana-o", "kana-i"], "explanation": "あおい (青い) means 'blue'."},
        {"type": "speaking", "skill": "speaking", "instructions": "Say the word for 'blue'.",
          "prompt_ja": "あおい", "prompt_reading": "あおい", "prompt_romaji": "aoi", "prompt_en": "blue", "audio_text": "あおい",
          "answer": "あおい", "accepted_answers": ["青い", "青"], "concept_ids": ["v-aoi"],
          "explanation": "Say each vowel clearly with equal length: a-o-i."}
      ]
    },
    {
      "id": "u0-l2", "position": 2, "title": "Katakana: words from other languages",
      "summary": "Katakana is used for loanwords. Learn to spot and read a few everyday ones.",
      "objectives": ["Understand when katakana is used", "Read コーヒー, カメラ, テレビ and ケーキ", "Understand the long-vowel mark ー"],
      "prerequisites": ["u0-l1"], "difficulty": 1, "estimated_minutes": 10,
      "vocabulary_ids": ["v-koohii", "v-kamera", "v-terebi", "v-keeki"], "grammar_ids": [],
      "exercises": [
        {"type": "presentation", "skill": "reading", "instructions": "Listen and read.",
          "prompt_ja": "コーヒー", "prompt_reading": "こーひー", "prompt_romaji": "koohii", "prompt_en": "coffee",
          "audio_text": "コーヒー", "concept_ids": ["v-koohii"],
          "explanation": "Katakana is mainly used for words borrowed from other languages. The bar ー makes the previous vowel long: コー = koo."},
        {"type": "multiple_choice", "skill": "reading", "instructions": "Which word means 'camera'?",
          "choices": ["カメラ", "テレビ", "コーヒー", "ケーキ"], "answer": "カメラ",
          "hints": ["It sounds almost like the English word: ka-me-ra."], "concept_ids": ["v-kamera"],
          "explanation": "カメラ (kamera) = camera."},
        {"type": "listening_choice", "skill": "listening", "instructions": "Listen and choose the word you hear.",
          "audio_text": "テレビ", "choices": ["テレビ", "カメラ", "ケーキ", "コーヒー"], "answer": "テレビ",
          "concept_ids": ["v-terebi"], "explanation": "テレビ (terebi) = television."},
        {"type": "multiple_choice", "skill": "vocabulary", "instructions": "What does this word mean?",
          "prompt_ja": "ケーキ", "prompt_reading": "けーき", "choices": ["cake", "coffee", "key", "camera"], "answer": "cake",
          "concept_ids": ["v-keeki"], "explanation": "ケーキ (keeki) = cake. Note the long vowel: ke-e-ki."},
        {"type": "typed_japanese", "skill": "writing", "instructions": "Type 'coffee' in katakana.",
          "prompt_en": "coffee (koohii)", "answer": "コーヒー", "meta": {"kana_strict": true},
          "hints": ["On most Japanese keyboards, press F7 or space to convert to katakana.", "Use ー for the long vowels."],
          "concept_ids": ["v-koohii"], "explanation": "コーヒー: コ + ー + ヒ + ー."},
        {"type": "speaking", "skill": "speaking", "instructions": "Say 'coffee' in Japanese.",
          "prompt_en": "coffee", "prompt_ja": "コーヒー", "prompt_romaji": "koohii", "audio_text": "コーヒー",
          "answer": "コーヒー", "accepted_answers": ["こーひー", "珈琲"], "concept_ids": ["v-koohii"],
          "explanation": "Hold the long vowels: koo-hii."}
      ]
    },
    {
      "id": "u0-l3", "position": 3, "title": "Greetings and everyday expressions",
      "summary": "Say hello, good morning, thank you and excuse me naturally.",
      "objectives": ["Greet people at different times of day", "Thank someone politely", "Use すみません to get attention or apologise"],
      "prerequisites": ["u0-l1"], "difficulty": 1, "estimated_minutes": 12,
      "vocabulary_ids": ["v-konnichiwa", "v-ohayou", "v-konbanwa", "v-arigatou", "v-sumimasen", "v-sayounara"], "grammar_ids": [],
      "exercises": [
        {"type": "presentation", "skill": "listening", "instructions": "Listen and repeat.",
          "prompt_ja": "こんにちは", "prompt_reading": "こんにちは", "prompt_romaji": "konnichiwa", "prompt_en": "Hello / Good afternoon",
          "audio_text": "こんにちは", "concept_ids": ["v-konnichiwa"],
          "explanation": "The final は in こんにちは is pronounced 'wa'. It's used from late morning to early evening."},
        {"type": "presentation", "skill": "listening", "instructions": "Listen and repeat.",
          "prompt_ja": "おはようございます", "prompt_reading": "おはようございます", "prompt_romaji": "ohayou gozaimasu", "prompt_en": "Good morning (polite)",
          "audio_text": "おはようございます", "concept_ids": ["v-ohayou"],
          "explanation": "With friends and family, the short form おはよう is common."},
        {"type": "listening_choice", "skill": "listening", "instructions": "What did you hear?",
          "audio_text": "ありがとうございます", "choices": ["Thank you", "Good morning", "Excuse me", "Goodbye"], "answer": "Thank you",
          "concept_ids": ["v-arigatou"], "explanation": "ありがとうございます is a polite 'thank you'."},
        {"type": "multiple_choice", "skill": "vocabulary", "instructions": "It's 7 pm and you meet your neighbour. What do you say?",
          "choices": ["こんばんは", "おはようございます", "こんにちは", "さようなら"], "answer": "こんばんは",
          "concept_ids": ["v-konbanwa"], "explanation": "こんばんは (konbanwa) is 'good evening'."},
        {"type": "ja_to_en", "skill": "vocabulary", "instructions": "Translate into English.",
          "prompt_ja": "すみません", "prompt_reading": "すみません", "prompt_romaji": "sumimasen", "audio_text": "すみません",
          "answer": "excuse me", "accepted_answers": ["sorry", "i'm sorry", "i am sorry", "pardon me", "excuse me, sorry", "sorry, excuse me"],
          "concept_ids": ["v-sumimasen"], "explanation": "すみません can mean 'excuse me' (to get attention) or 'I'm sorry'."},
        {"type": "en_to_ja", "skill": "writing", "instructions": "Translate into Japanese (polite).",
          "prompt_en": "Thank you.", "answer": "ありがとうございます。", "accepted_answers": ["有難うございます。", "どうもありがとうございます。"],
          "hints": ["It starts with ありがとう..."], "concept_ids": ["v-arigatou"],
          "explanation": "ありがとうございます is the polite form; ありがとう alone is casual."},
        {"type": "speaking", "skill": "speaking", "instructions": "Say 'hello' in Japanese.",
          "prompt_en": "Hello", "audio_text": "こんにちは", "answer": "こんにちは", "accepted_answers": ["今日は", "こんにちわ"],
          "concept_ids": ["v-konnichiwa"], "explanation": "kon-ni-chi-wa: five beats."}
      ]
    }
  ]
