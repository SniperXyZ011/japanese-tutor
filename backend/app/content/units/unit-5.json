          "accepted_answers": ["コーヒーがすきです。", "私はコーヒーが好きです。"], "concept_ids": ["g-suki", "v-koohii"],
          "explanation": "koo-hii ga su-ki de-su."}
      ]
    },
    {
      "id": "u5-l2", "position": 2, "title": "Requests and plans",
      "summary": "Make polite requests with て-form + ください and suggest plans with ましょう.",
      "objectives": ["Make polite requests with てください", "Suggest doing something together with ましょう"],
      "prerequisites": ["u5-l1"], "difficulty": 3, "estimated_minutes": 15,
      "vocabulary_ids": ["v-machimasu", "v-chotto", "v-issho"], "grammar_ids": ["g-te-kudasai", "g-mashou"],
      "exercises": [
