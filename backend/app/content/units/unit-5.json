{
  "unit": {"id": "unit-5", "position": 5, "title": "Early conversational ability", "level": "N5",
    "description": "Talk about likes, make requests with the て-form and suggest plans with ましょう."},
  "vocabulary": [
    {"id": "v-suki", "japanese": "好き", "reading": "すき", "romaji": "suki", "meaning": "liked, to like", "part_of_speech": "na-adjective"},
    {"id": "v-eiga", "japanese": "映画", "reading": "えいが", "romaji": "eiga", "meaning": "movie, film", "part_of_speech": "noun"},
    {"id": "v-machimasu", "japanese": "待ちます", "reading": "まちます", "romaji": "machimasu", "meaning": "to wait", "part_of_speech": "verb"},
    {"id": "v-chotto", "japanese": "ちょっと", "reading": "ちょっと", "romaji": "chotto", "meaning": "a little, a moment", "part_of_speech": "adverb"},
    {"id": "v-issho", "japanese": "一緒に", "reading": "いっしょに", "romaji": "issho ni", "meaning": "together", "part_of_speech": "adverb"}
  ],
  "grammar": [
    {"id": "g-suki", "name": "[thing] が好きです", "pattern": "[thing] が 好きです",
      "explanation": "好き is a な-adjective meaning 'liked'. The thing you like is marked with が, not を: すしが好きです = 'I like sushi'.",
      "examples": [{"japanese": "すしが好きです。", "reading": "すしがすきです。", "english": "I like sushi."},
        {"japanese": "映画が好きですか。", "reading": "えいががすきですか。", "english": "Do you like movies?"}]},
    {"id": "g-te-kudasai", "name": "Requests: て-form + ください", "pattern": "[verb て-form] ください",
      "explanation": "To ask someone to do something politely, use the て-form + ください. 食べます → 食べて, 見ます → 見て, 飲みます → 飲んで, 待ちます → 待って, 行きます → 行って (irregular).",
      "examples": [{"japanese": "ちょっと待ってください。", "reading": "ちょっとまってください。", "english": "Please wait a moment."}]},
    {"id": "g-mashou", "name": "Let's: ましょう", "pattern": "[verb stem] ましょう",
      "explanation": "Replace ます with ましょう to suggest doing something together: 'Let's ...'.",
      "examples": [{"japanese": "一緒に行きましょう。", "reading": "いっしょにいきましょう。", "english": "Let's go together."}]}
  ],
  "lessons": [
    {
      "id": "u5-l1", "position": 1, "title": "Likes and preferences",
      "summary": "Say what you like and ask others about their preferences with が好きです.",
      "objectives": ["Say what you like with が好きです", "Ask others what they like"],
      "prerequisites": ["u4-l2"], "difficulty": 3, "estimated_minutes": 10,
      "vocabulary_ids": ["v-suki", "v-eiga"], "grammar_ids": ["g-suki"],
      "exercises": [
        {"type": "presentation", "skill": "listening", "instructions": "Listen and repeat.",
