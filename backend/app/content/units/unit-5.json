          "audio_text": "すしが好きです。", "concept_ids": ["g-suki", "v-suki"], "explanation": "The u in すき is often barely pronounced: s'ki."},
        {"type": "multiple_choice", "skill": "grammar", "instructions": "Choose the missing particle: 'I like coffee.'",
          "prompt_ja": "コーヒー＿好きです。", "choices": ["が", "を", "で", "に"], "answer": "が",
          "concept_ids": ["g-suki"], "explanation": "好き takes が for the thing liked."},
        {"type": "ja_to_en", "skill": "vocabulary", "instructions": "Translate into English.",
