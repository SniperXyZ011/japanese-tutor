# --- Core ---
APP_ENV=development            # development | test | production
DATABASE_URL=postgresql+psycopg://jt:jt@localhost:5432/japanese_tutor
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
AUTH_MODE=local                # local (dev accounts) | supabase
LOCAL_JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false
# Supabase (AUTH_MODE=supabase). JWTs are verified via JWKS, the JWT secret, or /auth/v1/user.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=     # server-only; used to delete auth users on account deletion

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=            # leave empty in development to use the labelled mock tutor
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:3000
AI_PROVIDER=                   # optional override: openrouter | mock | none
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=300
MAX_CONVERSATION_TURNS=40

# --- Audio (browser speech APIs are used for the MVP) ---
TTS_PROVIDER=browser
STT_PROVIDER=browser
MAX_RECORDING_SECONDS=30
